# ==============================================================================
# SMART PARKING - ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL 18 (auth-service)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ------------------------------------------------------------------------------
# MySQL 8.0 (iot-service)
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=mysql

# ------------------------------------------------------------------------------
# MongoDB 8 (ia-service)
# ------------------------------------------------------------------------------
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=mongo
MONGO_AUTH_SOURCE=admin

# Connection String:
# mongodb://admin:mongo@localhost:27017/ia_service_db?authSource=admin

# ------------------------------------------------------------------------------
# Oracle 21c XE (parking-service)
# ------------------------------------------------------------------------------
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_EM_PORT=5500
ORACLE_USER=SYSTEM
ORACLE_PASSWORD=oracle
ORACLE_SID=XE
ORACLE_SERVICE_NAME=XEPDB1

# Connection String:
# jdbc:oracle:thin:@localhost:1521/XEPDB1

# ------------------------------------------------------------------------------
# SQL Server 2022 Express (payment-service)
# 8 o más caracteres con mayúsculas, minúsculas y números o símbolos (lo exige SQL Server)
# MSSQL_SA_PASSWORD: administrador (solo Docker); MSSQL_USER/PASSWORD: usuario del servicio
# ------------------------------------------------------------------------------
MSSQL_SA_PASSWORD=
MSSQL_USER=payment_user
MSSQL_PASSWORD=

# Connection String:
# jdbc:sqlserver://localhost:1433;databaseName=payment_service_db;encrypt=true;trustServerCertificate=true

# ------------------------------------------------------------------------------
# Redis 7 (cache compartido)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# ------------------------------------------------------------------------------
# MinIO (S3-compatible storage)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE=http://localhost:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=smart-parking-iot
MINIO_USE_SSL=false

# ------------------------------------------------------------------------------
# JWT (auth-service firma, parking-service valida: mismo valor)
# Generar con: openssl rand -hex 40
# ------------------------------------------------------------------------------
JWT_SECRET=

# Token de servicio (client credentials) de payment-service: lo usan auth-service (valida)
# y payment-service (lo pide). Mínimo 32 caracteres; sin él, payment-service no puede
# avisar a parking-service. Generar con: openssl rand -base64 48
PAYMENT_SERVICE_CLIENT_SECRET=

# Firma de los avisos de la pasarela de pagos (webhook) en payment-service. Mínimo 32 caracteres.
# Generar con: openssl rand -hex 32
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Correo - Gmail SMTP (auth-service)
# Usar una contraseña de aplicación, sin espacios ni comillas
# ------------------------------------------------------------------------------
MAIL_USERNAME=
MAIL_PASSWORD=

# ------------------------------------------------------------------------------
# reCAPTCHA v3 (auth-service) - opcional mientras recaptcha.enabled sea false
# ------------------------------------------------------------------------------
RECAPTCHA_SECRET_KEY=

# ------------------------------------------------------------------------------
# Admin inicial (auth-service, DataSeeder) - se crea en cada arranque (create-drop)
# Contraseña: 8-128 caracteres, mayúscula, minúscula, número y uno de @$!%*?&
# ------------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
